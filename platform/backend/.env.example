# Copy to .env and fill in what you have. Everything is optional except where noted.

# Database: SQLite by default. For Postgres: pip install "psycopg[binary]" and use
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/contacts
DATABASE_URL=sqlite:///./contacts.db

# --- AI (optional): parses pasted profile text and breaks ties between candidate domains ---
AI_PROVIDER=anthropic            # anthropic | openai | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5  # claude-haiku-5-5 is far cheaper for this extraction work
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Web search (strongly recommended): finds the company domain and pages that publish emails ---
SEARCH_PROVIDER=none             # brave | searxng | none
BRAVE_API_KEY=                   # https://brave.com/search/api/
SEARXNG_URL=                     # e.g. http://localhost:8080 (docker compose --profile search up)

# --- Optional authorized mailbox verification (uses Hunter credits) ---
HUNTER_API_KEY=

# --- Crawler politeness ---
CRAWLER_USER_AGENT=ContactDiscoveryBot/1.0 (+https://your-site.example/bot)
MAX_PAGES_PER_DOMAIN=12
MAX_EXTERNAL_PAGES=5
PER_HOST_INTERVAL_S=1.0
RESPECT_ROBOTS=true
CACHE_TTL_HOURS=168

# --- API ---
MAX_CONCURRENT_DISCOVERIES=3
MAX_BATCH_SIZE=100
CORS_ORIGINS=http://localhost:5173

# Set to 1 to run against the fictional demo data (no network, no keys)
DEMO_MODE=0
